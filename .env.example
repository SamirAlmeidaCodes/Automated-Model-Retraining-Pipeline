# Copy to .env to override defaults. Paths are resolved from the repository root.
DATABASE_URL=sqlite:///./db/pipeline.db
DATA_CSV_PATH=./data/breast_cancer.csv
DATA_META_PATH=./data/dataset_meta.json
INCOMING_DIR=./data/incoming
MODELS_DIR=./models

# f1_weighted, accuracy, precision_weighted, recall_weighted, or roc_auc
PRIMARY_METRIC=f1_weighted
HIGHER_IS_BETTER=true

# logistic_regression, gradient_boosting, or random_forest
ALGORITHM=logistic_regression
N_ESTIMATORS=120
LEARNING_RATE=0.08
MAX_DEPTH=3
RANDOM_STATE=42

# About 20% of rows (id % TEST_MODULUS == 0) stay in the holdout and are never trained on.
TEST_MODULUS=5

# Daily at 02:00 UTC. Set RETRAIN_INTERVAL_MINUTES to override the cron, for example 5.
RETRAIN_CRON=0 2 * * *
# RETRAIN_INTERVAL_MINUTES=5

TRAIN_ON_STARTUP=true
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
